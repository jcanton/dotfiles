{
    "$schema": "https://opencode.ai/config.json",
    "plugin": [
        "opencode-pty"
    ],
    // Set Kimi as default OpenCode model
    "model": "cscs/moonshotai/Kimi-K2.7-Code",
    "provider": {
        "cscs": {
            "npm": "@ai-sdk/anthropic",
            "name": "CSCS Inference",
            "options": {
                "baseURL": "https://api.inference.cscs.ch/v1",
                "systemMessageMode": "system",
            },
            "models": {
                "swiss-ai/Apertus-70B-Instruct-2509": {
                    "name": "Apertus 70B",
                    "limit": {
                        "context": 65536,
                        "output": 32768
                    }
                },
                "swiss-ai/Apertus-8B-Instruct-2509": {
                    "name": "Apertus 8B",
                    "limit": {
                        "context": 65536,
                        "output": 32768
                    }
                },
                "swiss-ai/Apertus-v1.5-70B": {
                    "name": "Apertus v1.5 70B",
                    "limit": {
                        "context": 262144,
                        "output": 32768
                    }
                },
                "swiss-ai/Apertus-v1.5-70B-thinking": {
                    "name": "Apertus v1.5 70B Thinking",
                    "tool_call": false,
                    "limit": {
                        "context": 262144,
                        "output": 32768
                    }
                },
                "swiss-ai/Apertus-v1.5-8B": {
                    "name": "Apertus v1.5 8B",
                    "limit": {
                        "context": 262144,
                        "output": 32768
                    }
                },
                "swiss-ai/Apertus-v1.5-8B-thinking": {
                    "name": "Apertus v1.5 8B Thinking",
                    "tool_call": false,
                    "limit": {
                        "context": 262144,
                        "output": 32768
                    }
                },
                "zai-org/GLM-5.2": {
                    "name": "GLM 5.2",
                    "limit": {
                        "context": 1048576,
                        "output": 131072
                    }
                },
                "moonshotai/Kimi-K2.7-Code": {
                    "name": "Kimi K2.7 Code",
                    "limit": {
                        "context": 262144,
                        "output": 32768
                    }
                }
            }
        }
    }
}
