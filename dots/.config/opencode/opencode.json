                    "limit": {
                        "context": 262144,
                        "output": 32768
                    }
                },
                "swiss-ai/Apertus-v1.5-8B-thinking": {
                    "name": "Apertus v1.5 8B Thinking",
                    "tool_call": false,
                    "modalities": {
                        "input": ["text", "image", "audio"],
                        "output": ["text"]
                    },
                    "limit": {
                        "context": 262144,
                        "output": 32768
                    }
                },
                "zai-org/GLM-5.3": {
                    "name": "GLM 5.3",
                    "modalities": {
                        "input": ["text"],
                        "output": ["text"]
                    },
                    "limit": {
                        "context": 1048576,
                        "output": 131072
                    }
                },
                "zai-org/GLM-5.3-Flash": {
                    "name": "GLM 5.3 Flash",
                    "modalities": {
                        "input": ["text", "image", "video"],
                        "output": ["text"]
                    },
                    "limit": {
                        "context": 1048576,
                        "output": 131072
                    }
                }
            }
        }
    }
