{
    "$schema": "https://opencode.ai/config.json",
    // Set GLM 5.3 as default OpenCode model
    "model": "cscs/zai-org/GLM-5.3",
    "provider": {
        "cscs": {
            "npm": "@ai-sdk/anthropic",
            "name": "CSCS Inference",
            "options": {
                "baseURL": "https://api.inference.cscs.ch/v1",
                "systemMessageMode": "system"
            },
            "models": {
                "google/gemma-4-31B-it": {
                    "name": "Gemma 4 31B",
                    "modalities": {
                        "input": ["text", "image", "video"],
                        "output": ["text"]
                    },
                    "limit": {
                        "context": 262144,
                        "output": 16384
                    }
                },
                "Qwen/Qwen3.8-27B-FP8": {
                    "name": "Qwen3.8 27B",
                    "modalities": {
                        "input": ["text", "image", "video"],
                        "output": ["text"]
                    },
                    "limit": {
                        "context": 262144,
                        "output": 16384
                    }
                },
                "Qwen/Qwen3.8-Flash-Next-FP8": {
                    "name": "Qwen3.8 Flash Next",
                    "modalities": {
                        "input": ["text", "image", "video"],
                        "output": ["text"]
                    },
                    "limit": {
                        "context": 262144,
                        "output": 16384
                    }
                },
                "swiss-ai/Apertus-v1.5-70B": {
                    "name": "Apertus v1.5 70B",
                    "modalities": {
                        "input": ["text", "image", "audio"],
                        "output": ["text"]
                    },
                    "limit": {
                        "context": 262144,
                        "output": 32768
                    }
                },
                "swiss-ai/Apertus-v1.5-70B-thinking": {
                    "name": "Apertus v1.5 70B Thinking",
                    "tool_call": false,
                    "modalities": {
                        "input": ["text", "image", "audio"],
                        "output": ["text"]
                    },
                    "limit": {
                        "context": 262144,
                        "output": 32768
                    }
                },
                "swiss-ai/Apertus-v1.5-8B": {
                    "name": "Apertus v1.5 8B",
                    "modalities": {
                        "input": ["text", "image", "audio"],
