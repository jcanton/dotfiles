#!/bin/sh
# git wt add <branch>|<owner>:<branch>
#     Worktree at <main repo>/.worktrees/<branch>, then `git wt setup` it.
#     A local branch is used as is (for a fork: if it tracks the fork),
#     otherwise <branch> is fetched and tracked.
#     <owner>:<branch> (GitHub's PR head label) tracks the owner's fork via
#     remote fork-<owner>, added if missing (same convention as git prgo).
# git wt setup [<path>]
#     icon4py worktrees only: link testdata, pyrightconfig.json and the
#     untracked .claude/skills from the main repo, uv sync if there is no
#     .venv yet. Safe to rerun.
set -e

setup() {
    wt=$(cd "${1:-.}" && pwd -P)
    [ "$(git -C "$wt" remote get-url origin 2>/dev/null)" = "git@github.com:C2SM/icon4py.git" ] || return 0
    # branch names can contain "/", so the depth below .worktrees varies
    case "$wt" in
    */.worktrees/*) branch=${wt#*/.worktrees/} ;;
    *) return 0 ;;
    esac
    # one .. per path component, e.g. .worktrees/a/b -> ../../..
    up=$(echo ".worktrees/$branch" | sed 's#[^/][^/]*#..#g')
    for item in testdata pyrightconfig.json .claude/skills; do
        [ -e "$wt/$up/$item" ] || continue
        target=$wt/$item
        # one .. per directory between the main repo and the link
        link=$(dirname ".worktrees/$branch/$item" | sed 's#[^/][^/]*#..#g')/$item
        [ "$(readlink "$target")" = "$link" ] && continue
        # re-point links with the wrong depth, but never touch a real file
        if [ -L "$target" ]; then
            rm "$target"
        elif [ -e "$target" ]; then
            continue
        fi
        echo "git wt: link $item"
        mkdir -p "$(dirname "$target")"
        ln -s "$link" "$target"
    done
    if [ ! -d "$wt/.venv" ]; then
        echo "git wt: uv sync"
        (cd "$wt" && uv sync)
    fi
}

add() {
    # always relative to the main repo, also when called from inside a worktree
    cd "$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")"
    case "$1" in
    *:*)
        owner=${1%%:*}
        branch=${1#*:}
        remote=fork-$owner
        if ! git remote get-url "$remote" >/dev/null 2>&1; then
            repo=$(basename "$(git remote get-url origin)" .git)
            git remote add "$remote" "git@github.com:$owner/$repo.git"
        fi
        ;;
    *)
        branch=$1
        remote=origin
        ;;
    esac
    if git show-ref --verify --quiet "refs/heads/$branch" && {
        [ "$remote" = origin ] ||
            [ "$(git rev-parse --abbrev-ref "$branch@{upstream}" 2>/dev/null)" = "$remote/$branch" ]
    }; then
        git worktree add ".worktrees/$branch" "$branch"
    else
        git fetch "$remote" "$branch"
        git worktree add --track -b "$branch" ".worktrees/$branch" "$remote/$branch"
    fi
    setup ".worktrees/$branch"
}

usage() {
    echo "usage: git wt add <branch>|<owner>:<branch>" >&2
    echo "       git wt setup [<path>]" >&2
    exit 1
}

case "$1" in
add)
    [ -n "$2" ] || usage
    add "$2"
    ;;
setup) setup "$2" ;;
*) usage ;;
esac
