#!/bin/sh
# git wt add <branch>|<owner>:<branch>
#     Worktree at <main repo>/.worktrees/<branch>, then `git wt setup` it.
#     A local branch is used as is (for a fork: if it tracks the fork),
#     otherwise <branch> is fetched and tracked.
#     <owner>:<branch> (GitHub's PR head label) tracks the owner's fork via
#     remote fork-<owner>, added if missing.
# git wt checkout <branch>|<owner>:<branch>
#     The same branch as `add`, checked out here instead (git prgo).
# git wt new <branch> [<base>]
#     New branch off <base> (default: the checked-out branch), in a worktree
#     at <main repo>/.worktrees/<branch>, then `git wt setup` it. Without
#     <base>, from a terminal and not on the default branch (main), asks
#     whether to branch off the checked-out branch or main. If <branch>
#     exists locally or on origin, or is <owner>:<branch>, does `add` instead.
# git wt setup [<path>]
#     icon4py worktrees only: link testdata, pyrightconfig.json and the
#     untracked .claude/skills from the main repo, uv sync if there is no
#     .venv yet. Safe to rerun.
set -e

setup() {
    wt=$(cd "${1:-.}" && pwd -P)
    [ "$(git -C "$wt" remote get-url origin 2>/dev/null)" = "git@github.com:C2SM/icon4py.git" ] || return 0
    # branch names can contain "/", so the depth below .worktrees varies
    case "$wt" in
    */.worktrees/*) branch=${wt#*/.worktrees/} ;;
    *) return 0 ;;
    esac
    # one .. per path component, e.g. .worktrees/a/b -> ../../..
    up=$(echo ".worktrees/$branch" | sed 's#[^/][^/]*#..#g')
    for item in testdata pyrightconfig.json .claude/skills; do
        [ -e "$wt/$up/$item" ] || continue
        target=$wt/$item
        # one .. per directory between the main repo and the link
        link=$(dirname ".worktrees/$branch/$item" | sed 's#[^/][^/]*#..#g')/$item
        [ "$(readlink "$target")" = "$link" ] && continue
        # re-point links with the wrong depth, but never touch a real file
        if [ -L "$target" ]; then
            rm "$target"
        elif [ -e "$target" ]; then
            continue
        fi
        echo "git wt: link $item"
        mkdir -p "$(dirname "$target")"
        ln -s "$link" "$target"
    done
    if [ ! -d "$wt/.venv" ]; then
        echo "git wt: uv sync"
        (cd "$wt" && uv sync)
    fi
}

# Set branch and remote for <branch>|<owner>:<branch>, adding remote
# fork-<owner> if missing. use_local=1 if the local branch can be used as is
# (for a fork: if it tracks the fork), otherwise the branch is fetched.
resolve() {
    case "$1" in
    *:*)
        branch=${1#*:}
        remote=fork-${1%%:*}
        if ! git remote get-url "$remote" >/dev/null 2>&1; then
            repo=$(basename "$(git remote get-url origin)" .git)
            git remote add "$remote" "git@github.com:${1%%:*}/$repo.git"
        fi
        ;;
    *)
        branch=$1
        remote=origin
        ;;
    esac
    use_local=
    if git show-ref --verify --quiet "refs/heads/$branch" && {
        [ "$remote" = origin ] ||
            [ "$(git rev-parse --abbrev-ref "$branch@{upstream}" 2>/dev/null)" = "$remote/$branch" ]
    }; then
        use_local=1
    else
        git fetch "$remote" "$branch"
    fi
}

add() {
    # always relative to the main repo, also when called from inside a worktree
    cd "$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")"
    resolve "$1"
    if [ -n "$use_local" ]; then
        git worktree add ".worktrees/$branch" "$branch"
    else
        git worktree add --track -b "$branch" ".worktrees/$branch" "$remote/$branch"
    fi
    setup ".worktrees/$branch"
}

checkout() {
    resolve "$1"
    if [ -n "$use_local" ]; then
        git checkout "$branch"
    else
        git checkout --track -b "$branch" "$remote/$branch"
    fi
}

new() {
    # an existing branch, local or on origin (or a fork's owner:branch), is
    # checked out with add instead
    if [ "${1#*:}" != "$1" ] || git show-ref --verify --quiet "refs/heads/$1" ||
        git ls-remote --exit-code --heads origin "$1" >/dev/null; then
        add "$1"
        return
    fi
    if [ -n "$2" ]; then
        base=$2
    else
        base=$(git branch --show-current)
        default=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD) || default=origin/main
        default=${default#origin/}
        if [ "$base" != "$default" ] && [ -t 0 ]; then
            printf 'Branch %s off [c]urrent %s or [m]ain (%s)? [c/m, other aborts] ' \
                "$1" "${base:-detached HEAD}" "$default"
            read -r answer
            case "$answer" in
            c) ;;
            m) base=$default ;;
            *) exit 1 ;;
            esac
        fi
        # the detached HEAD of this worktree, not of the main repo
        base=${base:-$(git rev-parse HEAD)}
    fi
    # always relative to the main repo, also when called from inside a worktree
    cd "$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")"
    git worktree add --no-track -b "$1" ".worktrees/$1" "$base"
    setup ".worktrees/$1"
}

usage() {
    echo "usage: git wt add <branch>|<owner>:<branch>" >&2
    echo "       git wt checkout <branch>|<owner>:<branch>" >&2
    echo "       git wt new <branch> [<base>]" >&2
    echo "       git wt setup [<path>]" >&2
    exit 1
}

case "$1" in
add)
    [ -n "$2" ] || usage
    add "$2"
    ;;
checkout)
    [ -n "$2" ] || usage
    checkout "$2"
    ;;
new)
    [ -n "$2" ] || usage
    new "$2" "$3"
    ;;
setup) setup "$2" ;;
*) usage ;;
esac
